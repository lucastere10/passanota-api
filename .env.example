# Supabase Postgres (Settings > Database > Connection string)
# Use postgresql+asyncpg:// ou postgresql:// — o driver asyncpg é aplicado automaticamente
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase (Settings > API — chaves novas sb_secret_ / sb_publishable_)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_STORAGE_BUCKET=invoice-photos

# Chave de acesso à API do projeto (header X-API-Key) — usada pelo frontend em PASSANOTA_API_KEY
API_KEY=

# Extração IA via LLM (openai | gemini | anthropic)
LLM_PROVIDER=openai
LLM_PROVIDER_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o
LLM_MAX_IMAGE_BYTES=5242880

DEBUG=false
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# E-mail (Resend) e autenticação
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@seudominio.com
FRONTEND_URL=http://localhost:3000
PLATFORM_ADMIN_NOTIFY_EMAIL=seu@email.com
PLATFORM_ADMIN_EMAIL=admin@seudominio.com
